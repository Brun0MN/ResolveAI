# Leave empty for an explicitly labeled offline rule-based DEMO; no claim of AI calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Timeout por requisição de rede à API (5 a 60 segundos); padrão 20.
GEMINI_REQUEST_TIMEOUT_S=20
# All services are local by default; NEVER expose this demonstrator publicly as-is.
LAB_TOKEN=resolveai-local-demo-token-change-this
LAB_URL=http://127.0.0.1:8001
DATABASE_PATH=./data/resolveai.sqlite3
LAB_DATABASE_PATH=./data/lab.sqlite3
AUTO_MIN_CONFIDENCE=0.70

# Real target process backend is configured automatically by Docker Compose.
# Keep empty for the local, emulated Python-only version.
REAL_LAB_URL=
